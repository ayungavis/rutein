<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Rutein fixtures" xmlns="http://www.topografix.com/GPX/1/1">
  <trk>
    <name>Ascent</name>
    <trkseg>
      <trkpt lat="0.000" lon="0"><ele>100</ele></trkpt>
      <trkpt lat="0.001" lon="0"><ele>140</ele></trkpt>
      <trkpt lat="0.002" lon="0"><ele>180</ele></trkpt>
    </trkseg>
  </trk>
  <trk>
    <name>Descent</name>
    <trkseg>
      <trkpt lat="0.002" lon="0"><ele>180</ele></trkpt>
      <trkpt lat="0.003" lon="0"><ele>150</ele></trkpt>
      <trkpt lat="0.004" lon="0"><ele>120</ele></trkpt>
      <trkpt lat="0.005" lon="0"><ele>100</ele></trkpt>
    </trkseg>
  </trk>
</gpx>
